{
  "name": "@kashin-dev/rmq.io",
  "version": "1.0.26",
  "description": "RabbitMQ complexity reduced to a socket.io like lib",
  "main": "dist/index.js",
  "repository": "git@github.com:j0t3x/rmq.io.git",
  "types": "dist/index.d.ts",
  "scripts": {
    "prepack": "npm run build",
    "build": "tsc",
    "dev-build": "nodemon",
    "start": "node --inspect=5858 -r ts-node/register ./src/index.ts",
    "test": "jest",
    "lint": "npx eslint --ext .ts src/ --fix",
    "pub": "node ./examples/mpub.js",
    "sub": "node ./examples/msub.js"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "exec": "npm start",
    "ext": "ts"
  },
  "author": "Tex",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@msgpack/msgpack": "^2.7.1",
    "amqplib": "^2.3.1",
    "pino": "^6.11.1"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22",
    "@types/pino": "^6.3.6",
    "@typescript-eslint/eslint-plugin": "^4.6.0",
    "@typescript-eslint/parser": "^4.6.0",
    "concurrently": "^6.3.0",
    "eslint": "^7.12.1",
    "eslint-config-prettier": "^8.5.0",
    "eslint-config-standard": "^14.1.1",
    "eslint-plugin-import": "^2.22.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^4.2.1",
    "eslint-plugin-standard": "^4.0.1",
    "jest": "^29.7.0",
    "jest-junit": "^13.2.0",
    "nodemon": "^2.0.5",
    "pino-pretty": "^4.3.0",
    "prettier": "^2.6.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  },
  "jest-junit": {
    "outputDirectory": "reports",
    "outputName": "jest-junit.xml",
    "ancestorSeparator": " › ",
    "uniqueOutputName": "false",
    "suiteNameTemplate": "{filepath}",
    "classNameTemplate": "{classname}",
    "titleTemplate": "{title}"
  },
  "volta": {
    "node": "22.23.4"
  }
}
